{
    "name": "padosoft/eval-harness-ai-bridge",
    "description": "Bridge between padosoft/eval-harness and the laravel/ai SDK: turn an AgentResponse into a scoreable trajectory, evaluate multi-turn conversations, and assert an agent against a golden dataset from Pest or PHPUnit.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "laravel-ai",
        "ai",
        "eval",
        "evaluation",
        "agent",
        "trajectory",
        "llm",
        "testing",
        "pest"
    ],
    "authors": [
        {
            "name": "Lorenzo Padovani",
            "email": "lorenzo.padovani@padosoft.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "padosoft/eval-harness": "^1.6",
        "symfony/yaml": "^7.0|^8.0"
    },
    "require-dev": {
        "laravel/ai": "^0.11",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "laravel/ai": "Required to evaluate laravel/ai agents. The bridge degrades to a clear exception without it, so nothing breaks at install time.",
        "pestphp/pest": "Adds the toPassEval() expectation. The PHPUnit assertion trait works without it."
    },
    "autoload": {
        "psr-4": {
            "Padosoft\\EvalHarnessAiBridge\\": "src/"
        },
        "files": [
            "src/Testing/pest.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Padosoft\\EvalHarnessAiBridge\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}

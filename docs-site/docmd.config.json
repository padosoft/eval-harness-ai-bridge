        }
      ]
    },
    {
      "title": "Guides",
      "icon": "book-open",
      "children": [
        {
          "title": "Trajectories",
          "path": "/guides/trajectories"
        },
        {
          "title": "Failed Runs & Timing",
          "path": "/guides/failed-runs-and-timing",
          "icon": "clock"
        },
        {
          "title": "Multi-turn conversations",
          "path": "/guides/conversations"
